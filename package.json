{
  "name": "abbox",
  "version": "0.1.0",
  "description": "Compiler that produces a framework-independent Product IR from application source code.",
  "author": "Kamran Elchuzade",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abbox-dev/abbox.git"
  },
  "homepage": "https://github.com/abbox-dev/abbox#readme",
  "bugs": {
    "url": "https://github.com/abbox-dev/abbox/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "abbox": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "ts-morph": "^28.0.0"
  }
}
